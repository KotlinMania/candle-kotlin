# Keep the Gradle wrapper jar checked in so CI can run `./gradlew`.
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
out/

# Upstream Rust source — clone freshly into tmp/ when porting begins.
# tmp/ is fully ignored; no .gitkeep, nothing tracked. Rust sources must
# never live in the repo.
tmp/

# Upstream Rust crate trees — never commit these at repo root.
# If porting, clone upstream into tmp/ instead.
