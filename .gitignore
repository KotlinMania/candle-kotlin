# Android SDK
/.android-sdk/
local.properties

# Swift Package Manager / Xcode workspace state.
#
# `src/swift/swift-test-harness/` is a real SPM package that exercises the Kotlin
# Swift Export pipeline against the artifacts produced by
# `embedSwiftExportForXcode`. Its `Package.swift`, `Tests/`, and
# per-package `.gitignore` (which ignores its own `.build/`) are all
# tracked. The patterns below cover the Swift/Xcode workspace state
# that this harness — or any future Swift Package added under the
# repo — would also produce.
#
# Note: the staging directory the Kotlin Swift Export pipeline writes
# to (`build/swift-test/lib*.a` + `.swiftmodule/` bundles when run with
# the Xcode-style env vars) is already covered by `build/` above.
.swiftpm/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
local.properties

# Cargo / Rust build artifacts
debug/
data/
dist/
target/
*.pdb
perf.data
flamegraph.svg
*.dylib
*.so
*.swp
*.swo
trace-*.json
bench_results/
native/*/build/
native/*/node_modules/

# npm install output; JS dependencies come from yarn via the Kotlin Gradle plugin
node_modules/
package-lock.json
!src/js/node-ffi/dist/package-lock.json

# Java build helpers are source; buildSrc/build remains generated output.
!buildSrc/
!buildSrc/src/
!buildSrc/src/**
!buildSrc/build.gradle.kts
!buildSrc/settings.gradle.kts

# Template build layout and generated files.
direct-translation/
*.log
*.stderr
*.o.tmp
**/src/native/interop/cinterop/*.a
**/.android-sdk/
**/.build/
!**/native/node-*/package-lock.json
!**/src/js/node-*/**/package-lock.json
